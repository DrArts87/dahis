#!/bin/sh
# Controleert vóór elke commit of app/sw.js bij de app-bestanden past, en
# werkt hem zo nodig bij met tools/release.py. Wordt sw.js bijgewerkt, dan
# stopt de commit: bekijk de wijziging, voeg hem toe en commit opnieuw.
#
# Eenmalig aanzetten per checkout:
#     git config core.hooksPath .githooks

cd "$(git rev-parse --show-toplevel)" || exit 1

PYTHON=
for kandidaat in python3 py python; do
    # Controleert ook de versie; vangt de lege 'python3'-alias van Windows af.
    if "$kandidaat" -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
        PYTHON=$kandidaat
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "pre-commit: geen Python 3.9 of nieuwer gevonden (python3, py of python)." >&2
    exit 1
fi

if ! "$PYTHON" tools/release.py --check >/dev/null 2>&1; then
    "$PYTHON" tools/release.py >&2 || exit 1
    echo "pre-commit: app/sw.js is bijgewerkt. Bekijk de wijziging, voer 'git add app/sw.js' uit en commit opnieuw." >&2
    exit 1
fi

if ! git diff --quiet -- app/sw.js; then
    echo "pre-commit: app/sw.js heeft wijzigingen die nog niet zijn toegevoegd. Voer 'git add app/sw.js' uit en commit opnieuw." >&2
    exit 1
fi
